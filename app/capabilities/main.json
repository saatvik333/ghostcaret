{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The settings and setup window: app commands and its own window events, nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-overview",
    "allow-save-settings",
    "allow-check-keys",
    "allow-set-api-key",
    "allow-remove-provider",
    "allow-test-provider",
    "allow-provider-models",
    "allow-sent-log",
    "allow-clear-sent-log",
    "allow-usage",
    "allow-clear-usage",
    "allow-seen-apps",
    "allow-style-samples",
    "allow-delete-style",
    "allow-set-setup-step",
    "allow-pause",
    "allow-resume",
    "allow-timings",
    "allow-local-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-check-model-file"
  ]
}
